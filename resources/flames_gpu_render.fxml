<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jwildfire.create.tina.swing.FlamesGPURenderControllerFX">
   <top>
      <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
          <Button fx:id="fromEditorBtn" mnemonicParsing="false" onAction="#onFromEditor" text="From Editor" />
            <Button fx:id="fromClipboardBtn" mnemonicParsing="false" onAction="#onFromClipboard" text="From Clipboard" />
            <Button fx:id="loadFlameBtn" mnemonicParsing="false" onAction="#onLoadFlame" text="Load Flame" />
            <CheckBox fx:id="autoSyncCbx" mnemonicParsing="false" onAction="#onAutoSync" text="AutoSync" />
            <Button fx:id="renderImageBtn" mnemonicParsing="false" onAction="#onRenderImage" text="Render Image" />
            <CheckBox fx:id="autoRenderCbx" mnemonicParsing="false" selected="true" text="Auto Render" />
            <Button fx:id="saveImageBtn" mnemonicParsing="false" onAction="#onSaveImage" text="Save Image" />
            <Button fx:id="toEditorBtn" mnemonicParsing="false" onAction="#onToEditor" text="To Editor" />
        </items>
      </ToolBar>
   </top>
   <left>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Size:" />
            <ToggleButton fx:id="fullSizeBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSizeChanged" text="Full" />
            <ToggleButton fx:id="halveSizeBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSizeChanged" text="1:2" />
            <ToggleButton fx:id="quarterSizeBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSizeChanged" text="1:4" />
            <Label text="Resolution:" />
            <ComboBox fx:id="resolutionProfileCmb" maxWidth="1.7976931348623157E308" />
            <Label text="Quality:" />
            <ComboBox fx:id="qualityProfileCmb" maxWidth="1.7976931348623157E308" />
            <CheckBox fx:id="denoiserOffCbx" mnemonicParsing="false" selected="true" text="Denoiser OFF" />
         </children>
      </VBox>
   </left>
   <center>
      <SplitPane dividerPositions="0.7" orientation="VERTICAL" prefHeight="200.0" prefWidth="160.0" BorderPane.alignment="CENTER">
        <items>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="160.0">
               <children>
                  <StackPane fx:id="imagePane" style="-fx-background-color: #000;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <ImageView fx:id="imageView" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
               </children>
            </AnchorPane>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="160.0">
               <children>
                  <SplitPane dividerPositions="0.5" prefHeight="160.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <items>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                           <children>
                              <TextArea fx:id="statsTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                           </children>
                        </AnchorPane>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                           <children>
                              <TextArea fx:id="gpuParamsTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                           </children>
                        </AnchorPane>
                    </items>
                  </SplitPane>
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
   </center>
</BorderPane>
