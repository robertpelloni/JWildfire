<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jwildfire.create.tina.swing.TransformationsXaosControllerFX">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <RadioButton fx:id="viewAsToBtn" mnemonicParsing="false" text="View as &quot;to&quot;">
               <toggleGroup>
                  <ToggleGroup fx:id="viewAsGroup" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="viewAsFromBtn" mnemonicParsing="false" text="View as &quot;from&quot;" toggleGroup="$viewAsGroup" />
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TableView fx:id="relWeightsTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="fromCol" prefWidth="75.0" text="From" />
          <TableColumn fx:id="toCol" prefWidth="75.0" text="To" />
          <TableColumn fx:id="weightCol" prefWidth="75.0" text="Weight" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <right>
      <VBox spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="relWeightField" prefWidth="80.0" />
            <HBox spacing="5.0">
               <children>
                  <Button fx:id="zeroBtn" mnemonicParsing="false" onAction="#zeroBtnClicked" text="0" />
                  <Button fx:id="oneBtn" mnemonicParsing="false" onAction="#oneBtnClicked" text="1" />
               </children>
            </HBox>
            <Button fx:id="resetBtn" mnemonicParsing="false" onAction="#resetBtnClicked" text="Reset" />
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>
