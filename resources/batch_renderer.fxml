<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jwildfire.create.tina.swing.BatchRendererControllerFX">
   <top>
      <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
          <Button fx:id="addFilesBtn" mnemonicParsing="false" onAction="#onAddFiles" text="Add Files" />
            <Button fx:id="removeBtn" mnemonicParsing="false" onAction="#onRemove" text="Remove" />
            <Button fx:id="removeAllBtn" mnemonicParsing="false" onAction="#onRemoveAll" text="Remove All" />
            <Button fx:id="moveUpBtn" mnemonicParsing="false" onAction="#onMoveUp" text="Up" />
            <Button fx:id="moveDownBtn" mnemonicParsing="false" onAction="#onMoveDown" text="Down" />
            <Button fx:id="startRenderBtn" mnemonicParsing="false" onAction="#onStartRender" style="-fx-font-weight: bold;" text="START RENDER" />
            <Button fx:id="showImageBtn" mnemonicParsing="false" onAction="#onShowImage" text="Show Image" />
        </items>
      </ToolBar>
   </top>
   <center>
      <SplitPane dividerPositions="0.75" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
               <children>
                  <TableView fx:id="jobsTable" editable="true" layoutX="14.0" layoutY="14.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                      <TableColumn fx:id="flameCol" prefWidth="250.0" text="Flame" />
                      <TableColumn fx:id="customSizeCol" prefWidth="100.0" text="Custom Size" />
                        <TableColumn fx:id="customQualityCol" prefWidth="100.0" text="Quality" />
                        <TableColumn fx:id="animationCol" prefWidth="75.0" text="Anim" />
                        <TableColumn fx:id="stateCol" prefWidth="100.0" text="State" />
                        <TableColumn fx:id="elapsedCol" prefWidth="100.0" text="Time (s)" />
                        <TableColumn fx:id="errorCol" prefWidth="200.0" text="Last Error" />
                    </columns>
                  </TableView>
               </children>
            </AnchorPane>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
               <children>
                  <VBox layoutX="14.0" layoutY="14.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Preview" />
                        <StackPane fx:id="previewPane" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: #000;" VBox.vgrow="ALWAYS">
                           <children>
                              <ImageView fx:id="previewImageView" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </StackPane>
                        <Label style="-fx-font-weight: bold;" text="Settings" />
                        <Label text="Resolution:" />
                        <ComboBox fx:id="resolutionProfileCmb" maxWidth="1.7976931348623157E308" />
                        <Label text="Quality:" />
                        <ComboBox fx:id="qualityProfileCmb" maxWidth="1.7976931348623157E308" />
                        <CheckBox fx:id="overwriteCbx" mnemonicParsing="false" text="Overwrite Images" />
                        <ToggleButton fx:id="gpuBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Enable GPU" />
                        <ToggleButton fx:id="denoiserOffBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Disable Denoiser" />
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
   </center>
   <bottom>
      <VBox spacing="5.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
         </padding>
         <children>
            <HBox spacing="10.0">
               <children>
                  <Label text="Job Progress:" />
                  <ProgressBar fx:id="jobProgressBar" maxWidth="1.7976931348623157E308" progress="0.0" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="Total Progress:" />
                  <ProgressBar fx:id="totalProgressBar" maxWidth="1.7976931348623157E308" progress="0.0" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
